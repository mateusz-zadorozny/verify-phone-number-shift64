#: verify-phone-number-shift64.php
msgid "Verify Phone Number Shift64"
msgstr "Verify Phone Number Shift64"

#. Description of the plugin
#: verify-phone-number-shift64.php
msgid "Smart phone number validation and formatting for WordPress using Google's libphonenumber library."
msgstr "Smart phone number validation and formatting for WordPress using Google's libphonenumber library."

#: verify-phone-number-shift64.php:57
msgid "Verify Phone Number Shift64: Composer autoloader not found. Please run \"composer install\" in the plugin directory."
